{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EvPlayer",
  "mainBinaryName": "EvPlayer",
  "version": "../package.json",
  "identifier": "io.github.evire1337.evplayer",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: evmedia: http://evmedia.localhost evproxy: http://evproxy.localhost",
        "media-src": "'self' blob: evmedia: http://evmedia.localhost evproxy: http://evproxy.localhost http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost evproxy: http://evproxy.localhost evmedia: http://evmedia.localhost blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Evire1337",
    "copyright": "MIT",
    "shortDescription": "EvPlayer",
    "longDescription": "Music player for SoundCloud, YouTube Music and your own files",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MDgzMzcyNTcwRDlFMzkKUldRNW5nMVhjak1JbGRnVjV2OHlFRVU0ZXVVWjFQNVFDMENrRzk1ckxFZFArS2lLL3NGSytLVUkK",
      "endpoints": [
        "https://github.com/Evire1337/evplayer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
