<?xml version="1.0" encoding="utf-8"?>
<!-- the home-screen player: cover on the left; the song and four buttons on the right.
     Compact on purpose: the buttons fit even when the widget is made smaller -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">
    
        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover_empty" />
    
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
    
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_marginEnd="22dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="EvPlayer"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />
    
            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_marginEnd="22dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_idle"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
    
            <!-- takes what is left, and gives it up first when the widget is short -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
    
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">
    
                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn"
                    android:contentDescription="Предыдущий"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_prev" />
    
                <ImageButton
                    android:id="@+id/widget_toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn"
                    android:contentDescription="Играть"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_play" />
    
                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn"
                    android:contentDescription="Следующий"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_next" />
    
                <ImageButton
                    android:id="@+id/widget_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn"
                    android:contentDescription="Нравится"
                    android:scaleType="center"
                    android:src="@drawable/ic_heart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- the EvPlayer snail in the corner -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_evplayer_logo" />
</FrameLayout>
