<?xml version="1.0" encoding="utf-8"?>
<!-- the middle-sized player, between the big one and a single row: a square cover the height
     of the widget; the song, the artist and four buttons beside it; the EvPlayer snail in the
     corner -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover_empty" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="EvPlayer"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="22dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_idle"
                android:textColor="#B3FFFFFF"
                android:textSize="12.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_small"
                    android:contentDescription="Предыдущий"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_w_prev" />
                <ImageButton
                    android:id="@+id/widget_toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_small"
                    android:contentDescription="Играть"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_w_play" />
                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_small"
                    android:contentDescription="Следующий"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_w_next" />
                <ImageButton
                    android:id="@+id/widget_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_small"
                    android:contentDescription="Нравится"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_evplayer_logo" />
</FrameLayout>
